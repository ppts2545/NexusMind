# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=NexusMind
APP_VERSION=2.0.0
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexusmind:nexusmind@postgres:5432/nexusmind

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE=qdrant

# Qdrant (primary)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nexusmind_chunks

# ChromaDB (optional backward compat — start with: docker compose --profile chroma up)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=nexusmind_docs

# ─── Object Storage ───────────────────────────────────────────────────────────
OBJECT_STORAGE=minio

# Local dev (OBJECT_STORAGE=local)
LOCAL_STORAGE_ROOT=/tmp/nexusmind_storage

# MinIO / S3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_RAW=nexusmind-raw
S3_BUCKET_CLEAN=nexusmind-clean
S3_BUCKET_DATASETS=nexusmind-datasets

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
MAX_TOKENS=2048

# ─── RAG ──────────────────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RAG_CONFIDENCE_THRESHOLD=0.35

# ─── Web Search Fallback (Tavily) ─────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_BACKFILL=true

# ─── Crawler ──────────────────────────────────────────────────────────────────
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=100

# ─── Training / Datasets ──────────────────────────────────────────────────────
DATASET_OUTPUT_DIR=/tmp/nexusmind_datasets
MINHASH_NUM_PERM=128
MINHASH_THRESHOLD=0.85
QUALITY_MIN_WORDS=50

# ─── HuggingFace ──────────────────────────────────────────────────────────────
HF_TOKEN=hf_...
HF_CACHE_DIR=/tmp/hf_cache

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
